# ─────────────────────────────────────────────────────────────────────────────
# Spotflow Insights — copy to .env.local. See the README for which values go to Vercel.
#
# YOU fill the three lines in section 1. I fill everything else from the
# Supabase and Vercel CLIs, then copy the app values into Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# 1 · YOUR TOKENS (used by the CLIs only; never deployed)
#    Supabase: supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=
#    Which Supabase project to use: the ref in its URL (supabase.com/dashboard/project/<ref>).
#    Leave empty to have me create a new project "spotflow-insights".
SUPABASE_PROJECT_REF=
#    Vercel: vercel.com/account/settings/tokens → Create (scope: the team that owns the project)
VERCEL_TOKEN=

# 2 · SUPABASE (filled by me from the project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#    Local only, for the one-time history import. Never set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# 3 · GOOGLE SIGN-IN (the existing OAuth client the reports site already uses;
#    pulled from the Vercel project. Nothing changes in Google Cloud.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4 · PRIVACY — HMAC key that turns customer emails into pseudonyms.
#    Generate with: openssl rand -base64 48. Keep it stable: changing it gives customers new ids.
PSEUDONYM_SECRET=

# 5 · ASK (Vercel AI Gateway). On Vercel this needs nothing: the deployment's
#    OIDC token authenticates. Locally, `vercel env pull` adds VERCEL_OIDC_TOKEN
#    (expires after 12h), or set an AI Gateway API key here instead.
ASK_MODEL=deepseek/deepseek-v4.1-flash
AI_GATEWAY_API_KEY=
